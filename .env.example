NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only. Needed only by explicitly run account provisioning scripts.
SUPABASE_SECRET_KEY=
# Optional book-search quota key. Server-only.
GOOGLE_BOOKS_API_KEY=
# Optional domestic book providers; configure one or both on the server only.
ALADIN_TTB_KEY=
KAKAO_BOOK_REST_KEY=
# Server-only, 32 random bytes encoded as 64 hex characters. Enroll in the DB
# with operator-setup-budget.mjs before enabling protected API routes.
BOOKFOREST_LIMITER_SECRET=
# Optional Google Drive integration (teacher accounts).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Base64-encoded random 32-byte key. Never commit a real value.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Set true only after enabling the Google provider in Supabase Auth.
GOOGLE_AUTH_ENABLED=false
# Optional teacher-only AI quiz drafts. Configure an existing funded gateway/model
# deliberately; manual quizzes work without AI. Never use NEXT_PUBLIC for secrets.
BOOKFOREST_AI_QUIZ_ENABLED=false
BOOKFOREST_AI_MODEL=
AI_GATEWAY_API_KEY=
