NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only. Needed only by explicitly run account provisioning scripts.
SUPABASE_SECRET_KEY=
# Optional book-search quota key. Server-only.
GOOGLE_BOOKS_API_KEY=
# Optional Google Drive integration (teacher accounts).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Base64-encoded random 32-byte key. Never commit a real value.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Set true only after enabling the Google provider in Supabase Auth.
GOOGLE_AUTH_ENABLED=false
